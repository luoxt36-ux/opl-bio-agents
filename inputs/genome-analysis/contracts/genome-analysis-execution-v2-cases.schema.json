{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opl://schemas/genome-analysis-execution-v2-cases",
  "type": "object",
  "additionalProperties": false,
  "required": ["surface_kind", "version", "agent_id", "cases"],
  "properties": {
    "surface_kind": { "const": "opl_bio_genome_analysis_execution_cases_v2" },
    "version": { "const": "v2" },
    "agent_id": { "const": "opl_bio_genome_analysis_agent" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "domain_id", "public_task_path", "public_task_sha256", "source_binding_path", "source_binding_sha256"],
        "properties": {
          "case_id": { "type": "string", "minLength": 1 },
          "domain_id": { "type": "string", "minLength": 1 },
          "public_task_path": { "type": "string", "minLength": 1 },
          "public_task_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "source_binding_path": { "type": "string", "minLength": 1 },
          "source_binding_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
