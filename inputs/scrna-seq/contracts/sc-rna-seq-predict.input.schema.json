{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://one-person-lab.local/contracts/opl-bio-agent/sc-rna-seq-predict.input.schema.json",
  "title": "OPL-Bio scRNA-seq Predict Input",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "cases",
    "out"
  ],
  "properties": {
    "cases": {
      "type": "string",
      "minLength": 1
    },
    "out": {
      "type": "string",
      "minLength": 1
    },
    "artifact_root": {
      "type": "string",
      "minLength": 1
    },
    "seed_rule_mode": {
      "enum": [
        "generic_signature",
        "legacy_kang_seed"
      ]
    },
    "python_bin": {
      "type": "string",
      "minLength": 1
    },
    "enable_scanpy_umap": {
      "type": "boolean"
    }
  }
}
